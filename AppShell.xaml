<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="NotasRapidas.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:NotasRapidas.Views"
       Shell.FlyoutBehavior="Disabled"
       Title="Notas rápidas">

    <!-- Pestañas inferiores: Notas e Historial.
         La ruta de detalle (NotaDetalle) se registra en AppShell.xaml.cs. -->
    <TabBar>
        <ShellContent Title="Notas"
                      Route="NotasPage"
                      ContentTemplate="{DataTemplate views:NotasPage}" />

        <ShellContent Title="Historial"
                      Route="HistorialPage"
                      ContentTemplate="{DataTemplate views:HistorialPage}" />
    </TabBar>

</Shell>
